COMPOSE_PROJECT_NAME=prisma

# Puertos publicados en el equipo
PRISMA_HTTP_PORT=8080
PRISMA_FRONTEND_PORT=5174
PRISMA_LEGACY_API_PORT=3001
PRISMA_MYSQL_PORT=3307

# Base MySQL exclusiva de PRISMA (solo desarrollo)
PRISMA_DB_NAME=prisma
PRISMA_DB_USER=prisma
PRISMA_DB_PASSWORD=change_me
PRISMA_DB_ROOT_PASSWORD=change_root_me

# Autenticacion local del legacy copiado
PRISMA_JWT_SECRET=change_with_a_long_random_value
PRISMA_ADMIN_PASSWORD=change_admin_password

# Integraciones externas desactivadas por defecto
GOOGLE_SHEETS_RECLUTAMIENTO_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

